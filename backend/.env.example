# ── 실행 모드 ──────────────────────────────────────────────
# true  : API 키 없이 목업 코드로 테스트
# false : 아래 API 키를 사용해 실제 LLM 호출
USE_MOCK_LLM=true

# API 호출 실패 시 목업으로 자동 대체할지 여부
ALLOW_MOCK_LLM_FALLBACK=true

# ── Gemini (Google) ────────────────────────────────────────
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ── GPT (OpenAI) ───────────────────────────────────────────
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Claude (Anthropic) ────────────────────────────────────
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── AI 평가 모델 (Semantic Score) ─────────────────────────
# 발급: https://platform.openai.com/api-keys (OpenAI 임베딩)
# 발급: https://www.voyageai.com/
# 발급: https://cohere.com/
# 발급: https://jina.ai/
# 발급: https://www.nomic.ai/
# 발급: https://zeroentropy.dev/
VOYAGE_API_KEY=your_voyage_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
JINA_API_KEY=your_jina_api_key_here
NOMIC_API_KEY=your_nomic_api_key_here
ZEROENTROPY_API_KEY=your_zeroentropy_api_key_here
